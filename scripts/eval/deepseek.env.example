# Copy this file to scripts/eval/.deepseek.env.local and fill in your key.
# This file is safe to commit; .deepseek.env.local is gitignored.

DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional overrides
# Keep this cheap by default; override on the command line when you explicitly want something pricier.
# DEEPSEEK_DEFAULT_CLAUDE_MODEL=claude-haiku-4-5
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro[1m]
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# DEEPSEEK_EFFORT_LEVEL=max
# DEEPSEEK_MAX_IN_FLIGHT_RUNS=16
# DEEPSEEK_MODEL_TIMEOUT_SECONDS=240
# EVAL_CONDITION_ADVANCE_THRESHOLD=30
