# Copy this file to scripts/eval/.eval.env.local to set eval-harness defaults once.
# This file (eval.env.example) is safe to commit; .eval.env.local is gitignored.
#
# Override order (lowest -> highest precedence), consistent across the harness:
#   built-in default  <  .eval.env.local / environment  <  CLI flag
#
# run-eval-v2.sh sources .eval.env.local at startup, so any EVAL_* var set here
# becomes the default for that run (a CLI flag still wins).

# Model-invocation wall-clock timeout, in seconds.
# 0 or negative = DISABLED (the correct default). A positive cap silently kills
# slow-but-valid runs (complex group-C prompts can exceed 240s) and biases results
# upward via survivor bias — never set a positive value for a publishable run.
EVAL_MODEL_TIMEOUT_SECONDS=0

# Other optional knobs (uncomment to change the default):
# EVAL_MAX_IN_FLIGHT_RUNS=16          # 0 = unlimited concurrency
# EVAL_CONDITION_ADVANCE_THRESHOLD=30
# EVAL_KEEP_TRANSCRIPTS=1
# EVAL_REPAIR_INVALID=0               # keep 0 — repair is half-broken + biases results
# EVAL_PLUGIN_VALIDATOR_MODE=local
